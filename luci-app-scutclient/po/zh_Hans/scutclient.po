msgstr "账号"

msgid "Network"
msgstr "网络"

msgid "Device"
msgstr "设备"

msgid "IPv4 address"
msgstr "IPv4 地址"

msgid "PID"
msgstr "PID"

msgid "Installed version"
msgstr "已安装版本"

msgid "Unavailable"
msgstr "不可用"

msgid "Applying…"
msgstr "正在执行…"

msgid "Operation completed."
msgstr "操作完成。"

msgid "Operation failed."
msgstr "操作失败。"

msgid "No instances configured. Add one on the Settings page."
msgstr "尚未配置实例。请在设置页添加。"

msgid "Internet available"
msgstr "互联网可用"

msgid "Campus authentication may be required"
msgstr "可能需要进行校园网认证"

msgid "No Internet connectivity"
msgstr "无互联网连接"

msgid "Unknown"
msgstr "未知"

# ---------- 日志页(logs) ----------
msgid "SCUT Client Logs"
msgstr "SCUT 客户端日志"

msgid "Per-instance log files under /tmp/scutclient. Only tail lines are shown; use Download for the full file."
msgstr "实例日志位于 /tmp/scutclient 下。页面仅显示尾部日志,完整内容请使用下载。"

msgid "Instance"
msgstr "实例"

msgid "Level"
msgstr "等级"

msgid "All"
msgstr "全部"

msgid "Lines"
msgstr "行数"

msgid "Auto Refresh"
msgstr "自动刷新"

msgid "Refresh"
msgstr "刷新"

msgid "Clear"
msgstr "清空"

msgid "Download"
msgstr "下载"

msgid "Clear this instance log?"
msgstr "确定清空该实例日志?"

msgid "No scutclient log is available."
msgstr "暂无 scutclient 日志。"

