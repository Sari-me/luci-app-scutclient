# luci-app-scutclient 简体中文翻译
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: luci-app-scutclient 1.5.0\n"

# ---------- 菜单(controller) ----------
msgid "SCUT Client"
msgstr "SCUT 客户端"

msgid "Status"
msgstr "状态"

msgid "Settings"
msgstr "设置"

msgid "Logs"
msgstr "日志"

msgid "About"
msgstr "关于"

# ---------- 设置页(Map/section) ----------
msgid "SCUT Client Settings"
msgstr "SCUT 客户端设置"

msgid "Manage multiple authentication instances. Every instance binds one WAN and runs its own process and log. Save the settings before restarting the service."
msgstr "管理多个认证实例。每个实例绑定一个 WAN,拥有独立进程与日志。重启服务前请先保存设置。"

msgid "General Settings"
msgstr "常规设置"

msgid "Enable"
msgstr "启用"

msgid "Master switch of the scutclient service. Disabled instances never start."
msgstr "scutclient 服务总开关。关闭后所有实例都不会启动。"

msgid "Authentication Instances"
msgstr "认证实例"

msgid "The section name is the instance id used by the service, the status page and the log file. One WAN can only be bound by one instance."
msgstr "配置节名称即实例 ID,用于服务、状态页和日志文件。一个 WAN 只能被一个实例绑定。"

msgid "Basic Settings"
msgstr "基本设置"

msgid "Advanced Settings"
msgstr "高级设置"

msgid "Logging"
msgstr "日志"

# ---------- Basic Tab ----------
msgid "Enabled"
msgstr "已启用"

msgid "Display name"
msgstr "显示名称"

msgid "Authentication method"
msgstr "认证方式"

msgid "802.1X + Dr.COM"
msgstr "802.1X + Dr.COM"

msgid "Web Portal / Wireless authentication"
msgstr "Web Portal / 无线认证"

msgid "802.1X uses EAPOL and the Dr.COM UDP protocol. Web Portal detects the captive portal Location on the selected WAN and logs in through it."
msgstr "802.1X 使用 EAPOL 与 Dr.COM UDP 协议。Web Portal 会在所选 WAN 上探测 Captive Portal 的 Location 并通过它登录。"

msgid "Username"
msgstr "用户名"

msgid "Usually your student number or the username issued by the university."
msgstr "通常是你的学号或学校分配的用户名。"

msgid "Password"
msgstr "密码"

msgid "Authentication interface"
msgstr "认证接口"

msgid "-- Select WAN interface --"
msgstr "-- 请选择 WAN 接口 --"

msgid "Logical OpenWrt network interface used for authentication. The service resolves it to the actual network device automatically. Each interface can only be bound by one instance."
msgstr "用于认证的 OpenWrt 逻辑接口。服务会自动将其解析为真实网络设备。每个接口只能被一个实例绑定。"

msgid "Please select an interface."
msgstr "请选择接口。"

msgid "Interface '%s' is already selected by instance '%s'. One WAN can only be bound by one instance."
msgstr "接口 '%s' 已被实例 '%s' 选择。一个 WAN 只能被一个实例绑定。"

msgid "MAC mode"
msgstr "MAC 模式"

msgid "Keep the current interface MAC"
msgstr "保持当前接口 MAC"

msgid "Random MAC"
msgstr "随机 MAC"

msgid "Custom MAC"
msgstr "自定义 MAC"

msgid "Random MACs are generated once and stored with the instance."
msgstr "随机 MAC 只生成一次,并保存在实例配置中。"

msgid "MAC address"
msgstr "MAC 地址"

msgid "Target MAC for random/custom mode. Leave empty in random mode to generate one automatically on the first start."
msgstr "随机/自定义模式使用的目标 MAC。随机模式下留空则首次启动时自动生成。"

msgid "Generate random MAC"
msgstr "生成随机 MAC"

# ---------- Portal Location ----------
msgid "Location"
msgstr "Location(跳转地址)"

msgid "Captive portal redirect URL. Select an authentication interface and use the test button to detect it automatically, or enter it manually. Re-test after the WAN or MAC configuration changes."
msgstr "Captive Portal 跳转地址。选择认证接口后点击测试按钮自动探测,或手动填写。WAN 或 MAC 配置变更后请重新测试。"

msgid "Location is too long."
msgstr "Location 过长。"

msgid "Location must start with http:// or https://."
msgstr "Location 必须以 http:// 或 https:// 开头。"

msgid "Send test request / Detect Location"
msgstr "发送测试请求 / 探测 Location"

msgid "Testing…"
msgstr "测试中…"

msgid "Location detected"
msgstr "探测成功"

msgid "No redirect detected"
msgstr "未检测到重定向"

msgid "HTTP response without Location"
msgstr "HTTP 响应未包含 Location"

msgid "Interface is not ready."
msgstr "接口未就绪。"

msgid "Probe failed."
msgstr "探测失败。"

msgid "Interface changed. Test Location again."
msgstr "接口已变更,请重新探测 Location。"

# ---------- Web Portal Tab ----------
msgid "Web Portal"
msgstr "Web Portal"

msgid "Portal protocol"
msgstr "Portal 认证方式"

msgid "Auto (prefer Dr.COM Web)"
msgstr "自动(优先 Dr.COM Web)"

msgid "Auto uses the Dr.COM Web login endpoint detected with the Location, which works even when the ePortal ports are unreachable. Select a backend manually only if your campus network requires it."
msgstr "自动模式使用随 Location 探测到的 Dr.COM Web 登录接口,即使 ePortal 端口不可达也能登录。仅当校园网明确需要时才手动指定后端。"

msgid "Program index override"
msgstr "Program index 覆盖"

msgid "Optional. Program index of the Dr.COM Web login page. Leave empty unless the campus portal requires a specific value."
msgstr "可选。Dr.COM Web 登录页的 program index。除非校园门户要求特定值,否则请留空。"

msgid "Page index override"
msgstr "Page index 覆盖"

msgid "JS version override"
msgstr "JS 版本覆盖"

msgid "R3 override"
msgstr "R3 覆盖"

msgid "Optional Dr.COM Web R3 value. Only needed when the campus portal uses the carrier selection mode (enable_r3)."
msgstr "可选的 Dr.COM Web R3 值。仅当校园门户使用运营商选择模式(enable_r3)时需要。"

msgid "Account suffix"
msgstr "账号后缀"

msgid "Optional account suffix. Leave empty for normal campus accounts. Examples: @dx, @lt."
msgstr "可选的账号后缀。普通校园账号请留空。示例:@dx、@lt。"

msgid "Connect timeout (seconds)"
msgstr "连接超时(秒)"

msgid "Request timeout (seconds)"
msgstr "请求超时(秒)"

msgid "Online check interval (seconds)"
msgstr "在线检测间隔(秒)"

msgid "Verify TLS certificates"
msgstr "校验 TLS 证书"

msgid "Validate https:// portal certificates against the system CA bundle."
msgstr "对 https:// Portal 使用系统 CA 校验证书。"

msgid "ePortal HTTP port"
msgstr "ePortal HTTP 端口"

msgid "ePortal HTTPS port"
msgstr "ePortal HTTPS 端口"

msgid "ePortal login port used when the Location is http://. Leave empty to use the protocol default."
msgstr "Location 为 http:// 时登录使用的 ePortal 端口。留空使用协议默认值。"

msgid "ePortal login port used when the Location is https://. Leave empty to use the protocol default."
msgstr "Location 为 https:// 时登录使用的 ePortal 端口。留空使用协议默认值。"

# ---------- Dr.COM Tab ----------
msgid "Authentication server"
msgstr "认证服务器"

msgid "DNS server"
msgstr "DNS 服务器"

msgid "Dr.com version"
msgstr "Dr.com 版本"

msgid "DrAuthSvr.dll hash"
msgstr "DrAuthSvr.dll 哈希"

msgid "Allowed online time"
msgstr "允许联网时间"

msgid "Invalid time format. Use H:MM or HH:MM, for example 6:15."
msgstr "时间格式无效。使用 H:MM 或 HH:MM,例如 6:15。"

msgid "Hostname sent to server"
msgstr "发送给服务器的主机名"

# ---------- Advanced Tab ----------
msgid "Routing isolation"
msgstr "路由隔离"

msgid "Auto (mwan3 aware)"
msgstr "自动(感知 mwan3)"

msgid "Native binding only"
msgstr "仅原生绑定"

msgid "Force mwan3 use"
msgstr "强制 mwan3 use"

msgid "Auto launches the instance through 'mwan3 use' when mwan3 is running, so authentication traffic keeps its WAN identity under policy routing. Native uses the daemon bindings only."
msgstr "自动模式在 mwan3 运行时通过 'mwan3 use' 启动实例,使认证流量在策略路由下仍保持 WAN 身份。原生模式仅使用守护进程自身绑定。"

msgid "Portal backend"
msgstr "Portal 后端"

msgid "Source IPv4"
msgstr "源 IPv4"

msgid "Heartbeat interval (seconds)"
msgstr "心跳间隔(秒)"

msgid "Heartbeat timeout (seconds)"
msgstr "心跳超时(秒)"

msgid "EAP receive timeout (seconds)"
msgstr "EAP 接收超时(秒)"

msgid "EAP retries"
msgstr "EAP 重试次数"

msgid "Online hook"
msgstr "上线钩子"

msgid "Shell command executed after EAP authentication success. Use with care."
msgstr "EAP 认证成功后执行的 shell 命令。请谨慎使用。"

msgid "Offline hook"
msgstr "下线钩子"

msgid "Shell command executed when the client is forced offline. Use with care."
msgstr "客户端被强制下线时执行的 shell 命令。请谨慎使用。"

# ---------- Logging Tab ----------
msgid "Log level"
msgstr "日志等级"

msgid "Maximum log size (bytes)"
msgstr "日志最大字节数"

msgid "Log files to keep"
msgstr "保留日志份数"

msgid "System log"
msgstr "系统日志"

msgid "Mirror log output to the OpenWrt system log via procd."
msgstr "通过 procd 将日志输出到 OpenWrt 系统日志。"

msgid "Per-instance file log"
msgstr "实例文件日志"

msgid "Write this instance's log to /tmp/scutclient/<instance>.log."
msgstr "将此实例的日志写入 /tmp/scutclient/<实例>.log。"

# ---------- 状态页(status) ----------
msgid "SCUT Client Status"
msgstr "SCUT 客户端状态"

msgid "Every instance reports its own authentication, process and interface state. Account passwords are intentionally never displayed here."
msgstr "每个实例独立上报认证、进程与接口状态。此处刻意不显示账号密码。"

msgid "Master service"
msgstr "服务总开关"

msgid "Configured instances"
msgstr "已配置实例"

msgid "Running instances"
msgstr "运行中实例"

msgid "Online instances"
msgstr "在线实例"

